---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Booth House — Frank Lloyd Wright, Glencoe, Illinois",
  description = "The definitive resource on the Sherman Booth House, 265 Sylvan Road, Glencoe, Illinois — designed by Frank Lloyd Wright, 1915. Covers the Ravine Bluffs Development, the Booth Cottage, the Glasner House, and the full history of Wright's work in Glencoe."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- GLightbox -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
  </head>
  <body>
    <slot />
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
    <script>
      // @ts-ignore
      const lightbox = GLightbox({ selector: '.glightbox' });
    </script>
  </body>
</html>
