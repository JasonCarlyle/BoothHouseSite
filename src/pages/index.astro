---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import History from '../components/History.astro';
import OriginalOwners from '../components/OriginalOwners.astro';
import Gallery from '../components/Gallery.astro';
import LegoModel from '../components/LegoModel.astro';
import FloorPlans from '../components/FloorPlans.astro';
import Timeline from '../components/Timeline.astro';
import RavineBluffs from '../components/RavineBluffs.astro';
import Bibliography from '../components/Bibliography.astro';
import Resources from '../components/Resources.astro';
import '../styles/global.css';
---

<Layout>
  <Nav />
  <Hero />
  <History />
  <OriginalOwners />
  <Gallery />
  <LegoModel />
  <FloorPlans />
  <Timeline />
  <RavineBluffs />
  <Bibliography />
  <Resources />

  <footer class="footer">
    <div class="container">
      <div class="footer-inner">
        <div class="footer-left">
          <p class="footer-name">The Booth House</p>
          <p class="footer-sub">Designed by Frank Lloyd Wright · Glencoe, Illinois · 1915</p>
        </div>
        <div class="footer-right">
          <a href="https://franklloydwright.org" target="_blank" rel="noopener" class="footer-link">Frank Lloyd Wright Foundation →</a>
          <a href="https://en.wikipedia.org/wiki/Sherman_Booth_House" target="_blank" rel="noopener" class="footer-link">Wikipedia →</a>
          <a href="https://library.columbia.edu/libraries/avery/franklloydwright.html" target="_blank" rel="noopener" class="footer-link">Avery Archives →</a>
          <a href="https://www.apizm.com/" target="_blank" rel="noopener" class="footer-link">Photography: Andrew Pielage →</a>
        </div>
      </div>
      <p class="footer-copy">&copy; {new Date().getFullYear()} · All rights reserved</p>
    </div>
  </footer>
</Layout>

<style>
  .footer {
    background: var(--color-bg-dark);
    color: rgba(255,255,255,0.6);
    padding: var(--space-lg) 0 var(--space-md);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .footer-name {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-white);
    margin-bottom: 0.25rem;
  }

  .footer-sub {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .footer-link {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-light);
    transition: color 0.2s;
  }

  .footer-link:hover {
    color: var(--color-white);
  }

  .footer-copy {
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  @media (max-width: 600px) {
    .footer-inner { flex-direction: column; }
  }
</style>
