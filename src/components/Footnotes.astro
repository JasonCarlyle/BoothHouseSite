<section class="footnotes" id="footnotes">
  <div class="container">
    <div class="fn-inner">
      <p class="fn-heading">Notes &amp; Sources</p>
      <ol class="fn-list">
        {footnotes.map((fn) => (
          <li id={`fn-${fn.n}`} class="fn-item">
            <span class="fn-num">{fn.n}</span>
            <span class="fn-text" set:html={fn.citation}></span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .footnotes {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding: var(--space-lg) 0;
  }

  .fn-inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .fn-heading {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .fn-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .fn-item {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .fn-num {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    min-width: 1.5rem;
    flex-shrink: 0;
    font-family: var(--font-sans);
  }

  .fn-text {
    font-size: var(--text-xs);
    font-family: var(--font-sans);
    color: var(--color-text-muted);
    line-height: 1.6;
  }
</style>
