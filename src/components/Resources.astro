---

<section class="resources" id="resources">
  <div class="container">
    <div class="resources-header">
      <p class="section-label">Further Reading</p>
      <h2 class="section-title">Resources &amp; Links</h2>
      <div class="divider"></div>
      <p class="resources-intro">
        Primary sources, archives, scholarship, and organizations connected to the
        Booth House, the Ravine Bluffs Development, and Frank Lloyd Wright's Prairie period.
      </p>
    </div>

    <div class="resources-grid">
      {groups.map((group) => (
        <div class="resource-group">
          <h3 class="group-label" set:html={group.label}></h3>
          <ul class="link-list">
            {group.links.map((link) => (
              <li class="link-item">
                <a href={link.url} target="_blank" rel="noopener" class="link-title">
                  {link.title} →
                </a>
                <p class="link-desc">{link.description}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .resources {
    background: var(--color-bg-dark);
    color: rgba(255,255,255,0.85);
  }

  .resources .section-label {
    color: var(--color-accent-light);
  }

  .resources .section-title {
    color: var(--color-white);
  }

  .resources .divider {
    background: var(--color-accent);
  }

  .resources-header {
    max-width: var(--content-width);
    margin: 0 auto var(--space-lg);
  }

  .resources-intro {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 300;
    color: rgba(255,255,255,0.6);
    line-height: 1.7;
    margin-top: calc(-1 * var(--space-sm));
  }

  .resources-grid {
    max-width: var(--content-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(440px, 1fr));
    gap: var(--space-xl) var(--space-xl);
  }

  .group-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent-light);
    margin-bottom: var(--space-md);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .link-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .link-title {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-white);
    text-decoration: none;
    transition: color 0.2s;
    line-height: 1.4;
  }

  .link-title:hover {
    color: var(--color-accent-light);
  }

  .link-desc {
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    font-weight: 300;
    color: rgba(255,255,255,0.5);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .resources-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
