                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Download PNG
            </a>
            <a href="/downloads/ShermanBoothHouse.io" download="ShermanBoothHouse.io" class="download-btn">
