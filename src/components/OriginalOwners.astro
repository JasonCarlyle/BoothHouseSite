<style>
  .owners {
    position: relative;
    background: var(--color-bg);
    overflow: hidden;
  }

  .owners-bg-strip {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: #F0EBE3;
    z-index: 0;
  }

  .container {
    position: relative;
    z-index: 1;
  }

  .owners-inner {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-xl);
    align-items: start;
  }

  .owners-text p {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 300;
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .owners-subhead {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--color-text);
    margin: var(--space-lg) 0 0.75rem;
    letter-spacing: 0.01em;
  }

  .owners-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .detail-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .detail-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .detail-value {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-text);
  }

  .owners-photo {
    position: sticky;
    top: 7rem;
  }

  .photo-frame {
    aspect-ratio: 3/4;
    overflow: hidden;
    background: var(--color-border);
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: sepia(15%) contrast(1.05);
  }

  .owners-photo figcaption {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: 0.75rem;
    text-align: center;
    letter-spacing: 0.04em;
    font-style: italic;
  }

  @media (max-width: 900px) {
    .owners-inner {
      grid-template-columns: 1fr;
    }

    .owners-photo {
      position: static;
      max-width: 360px;
      margin: 0 auto;
    }
  }
</style>
