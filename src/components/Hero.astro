---
---

<section class="hero" id="top">
  <div class="hero-bg">
    <!-- Replace hero.jpg with your best exterior photo -->
    <img src="/images/hero/hero.jpg" alt="The Booth House" class="hero-img" />
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-content container">
    <p class="hero-eyebrow">A Frank Lloyd Wright House</p>
    <h1 class="hero-title">The Booth House</h1>
    <p class="hero-subtitle">Glencoe, Illinois &nbsp;·&nbsp; 1915</p>
    <div class="hero-rule"></div>
    <p class="hero-tagline">
      One of Wright's great Prairie period designs — a home built for living in harmony with the land.
    </p>
  </div>

  <a href="#history" class="hero-scroll-cue" aria-label="Scroll to history">
    <span class="scroll-line"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    display: flex;
    align-items: flex-end;
    padding-bottom: 8rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(20, 16, 10, 0.15) 0%,
      rgba(20, 16, 10, 0.2) 40%,
      rgba(20, 16, 10, 0.75) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    color: var(--color-white);
    max-width: 800px;
  }

  .hero-eyebrow {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent-light);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 8vw, var(--text-6xl));
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-white);
  }

  .hero-subtitle {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.75);
    margin-top: 0.75rem;
    letter-spacing: 0.05em;
  }

  .hero-rule {
    width: 50px;
    height: 1px;
    background: var(--color-accent-light);
    margin: 1.5rem 0;
  }

  .hero-tagline {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.85);
    max-width: 500px;
    line-height: 1.6;
    font-style: italic;
  }

  .hero-scroll-cue {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .scroll-line {
    display: block;
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.6), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.4; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.1); }
  }

  @media (max-width: 768px) {
    .hero { padding-bottom: 5rem; }
  }
</style>
