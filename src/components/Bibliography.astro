---
const books = [
  {
    author: "Betsky, Aaron; Shapiro, Gideon Fink; Pielage, Andrew",
    title: "50 Lessons to Learn from Frank Lloyd Wright",
    publisher: "Rizzoli, New York",
    year: "2021",
    isbn: "978-0-8478-6536-9",
    note: "Photographs by Andrew Pielage, who visited 265 Sylvan Road in October 2024 as part of his ongoing #500fllwproject to document all surviving Wright buildings. The book distills Wright's architectural principles through his built work.",
    url: "https://www.rizzoliusa.com/book/9780847865369/",
  },
  {
    author: "Storrer, William Allin",
    title: "The Architecture of Frank Lloyd Wright: A Complete Catalog (4th ed.)",
    publisher: "University of Chicago Press",
    year: "2006",
    isbn: "978-0-226-77620-6",
    note: "The standard reference catalogue of every Wright building. The Ravine Bluffs Development is documented with individual entries for the Booth House and each of the six development structures. The essential starting point for any Wright research.",
    url: "https://press.uchicago.edu/ucp/books/book/chicago/A/bo26176057.html",
  },
  {
    author: "Pfeiffer, Bruce Brooks; Gössel, Peter (eds.)",
    title: "Frank Lloyd Wright: Complete Works, Vol. 1, 1885–1916",
    publisher: "Taschen",
    year: "2009",
    isbn: "978-3-8365-0927-5",
    note: "The first volume of Taschen's three-volume complete works covers all of Wright's designs through 1916, the year the Booth House was completed. Includes drawings, photographs, and critical essays on the Prairie period.",
    url: "https://www.amazon.com/Frank-Lloyd-Wright-Complete-1885-1916/dp/383650927X",
  },
  {
    author: "Hitchcock, Henry-Russell",
    title: "In the Nature of Materials: The Buildings of Frank Lloyd Wright, 1887–1941",
    publisher: "Duell, Sloan and Pearce, New York",
    year: "1942",
    isbn: "",
    note: "The first comprehensive scholarly survey of Wright's work, published during his lifetime. Hitchcock's catalogue of the Prairie period establishes the critical framework within which the Booth House and the Ravine Bluffs Development have been understood ever since.",
    url: "",
  },
  {
    author: "Nute, Kevin",
    title: "Frank Lloyd Wright and Japan: The Role of Traditional Japanese Art and Architecture in the Work of Frank Lloyd Wright",
    publisher: "Van Nostrand Reinhold / Routledge",
    year: "1993",
    isbn: "978-0-442-01419-0",
    note: "The definitive scholarly treatment of Wright's relationship with Japanese culture. Essential context for the Ravine Bluffs commission: the Booth House was designed while Wright was making his first extended trips to Japan and working on the Imperial Hotel — a period of deep Japanese influence on his ornamental and spatial language.",
    url: "https://archive.org/details/franklloydwright0000nute",
  },
  {
    author: "Heinz, Thomas A.",
    title: "Frank Lloyd Wright Field Guide: Northern Illinois, Wisconsin, Minnesota",
    publisher: "Academy Editions / Academy Group",
    year: "1996",
    isbn: "978-1-85490-454-8",
    note: "A site-by-site field guide to Wright's buildings in the upper Midwest. Glencoe and the Ravine Bluffs Development are among the featured destinations. Practical companion for visiting the neighborhood today.",
    url: "",
  },
  {
    author: "Gill, Brendan",
    title: "Many Masks: A Life of Frank Lloyd Wright",
    publisher: "Putnam, New York",
    year: "1987",
    isbn: "978-0-399-13232-8",
    note: "One of the standard Wright biographies, covering the turbulent years of the Booth commission in depth — including the Taliesin fire of 1914, the Wasmuth Portfolio, and Wright's travels to Japan. The Booth friendship is addressed in the context of Wright's legal and personal affairs of the period.",
    url: "",
  },
];
---

<section class="bibliography" id="bibliography">
  <div class="container">
    <div class="bib-header">
      <p class="section-label">Scholarship</p>
      <h2 class="section-title">In Print</h2>
      <div class="divider"></div>
      <p class="bib-intro">
        Books in which the Sherman Booth House, the Ravine Bluffs Development, or the
        critical context of their creation is documented or discussed. This list focuses
        on works that bear directly on 265 Sylvan Road and the years of its design.
      </p>
    </div>

    <div class="bib-list">
      {books.map((book) => (
        <div class="bib-entry">
          <div class="bib-spine"></div>
          <div class="bib-content">
            <p class="bib-author">{book.author}</p>
            {book.url ? (
              <a href={book.url} target="_blank" rel="noopener" class="bib-title">{book.title}</a>
            ) : (
              <p class="bib-title bib-title--plain">{book.title}</p>
            )}
            <p class="bib-meta">
              {book.publisher}{book.year ? `, ${book.year}` : ""}
              {book.isbn ? <span class="bib-isbn"> · ISBN {book.isbn}</span> : null}
            </p>
            <p class="bib-note">{book.note}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bibliography {
    background: var(--color-bg);
  }

  .bib-header {
    max-width: var(--content-width);
    margin: 0 auto var(--space-lg);
  }

  .bib-intro {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 300;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-top: calc(-1 * var(--space-sm));
  }

  .bib-list {
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .bib-entry {
    display: grid;
    grid-template-columns: 4px 1fr;
    gap: 0 var(--space-md);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .bib-entry:first-child {
    border-top: 1px solid var(--color-border);
  }

  .bib-spine {
    background: var(--color-accent);
    margin-top: 0.3rem;
    height: 1.2rem;
    flex-shrink: 0;
  }

  .bib-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .bib-author {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .bib-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--color-text);
    font-style: italic;
    line-height: 1.3;
    text-decoration: none;
    transition: color 0.2s;
  }

  a.bib-title:hover {
    color: var(--color-accent);
  }

  .bib-title--plain {
    display: block;
  }

  .bib-meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
  }

  .bib-isbn {
    opacity: 0.7;
  }

  .bib-note {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: 300;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-top: 0.25rem;
  }
</style>
