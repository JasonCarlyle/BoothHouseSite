---

<section class="bibliography" id="bibliography">
  <div class="container">
    <div class="bib-header">
      <p class="section-label">Scholarship</p>
      <h2 class="section-title">In Print</h2>
      <div class="divider"></div>
      <p class="bib-intro">
        Books in which the Sherman Booth House, the Ravine Bluffs Development, or the
        critical context of their creation is documented or discussed. This list focuses
        on works that bear directly on 265 Sylvan Road and the years of its design.
      </p>
    </div>

    <div class="bib-list">
      {books.map((book) => (
        <div class="bib-entry">
          <div class="bib-spine"></div>
          <div class="bib-content">
            <p class="bib-author">{book.author}</p>
            {book.url ? (
              <a href={book.url} target="_blank" rel="noopener" class="bib-title">{book.title}</a>
            ) : (
              <p class="bib-title bib-title--plain">{book.title}</p>
            )}
            <p class="bib-meta">
              {book.publisher}{book.year ? `, ${book.year}` : ""}
              {book.isbn ? <span class="bib-isbn"> · ISBN {book.isbn}</span> : null}
            </p>
            <p class="bib-note">{book.note}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bibliography {
    background: var(--color-bg);
  }

  .bib-header {
    max-width: var(--content-width);
    margin: 0 auto var(--space-lg);
  }

  .bib-intro {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 300;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-top: calc(-1 * var(--space-sm));
  }

  .bib-list {
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .bib-entry {
    display: grid;
    grid-template-columns: 4px 1fr;
    gap: 0 var(--space-md);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .bib-entry:first-child {
    border-top: 1px solid var(--color-border);
  }

  .bib-spine {
    background: var(--color-accent);
    margin-top: 0.3rem;
    height: 1.2rem;
    flex-shrink: 0;
  }

  .bib-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .bib-author {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .bib-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--color-text);
    font-style: italic;
    line-height: 1.3;
    text-decoration: none;
    transition: color 0.2s;
  }

  a.bib-title:hover {
    color: var(--color-accent);
  }

  .bib-title--plain {
    display: block;
  }

  .bib-meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
  }

  .bib-isbn {
    opacity: 0.7;
  }

  .bib-note {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: 300;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-top: 0.25rem;
  }
</style>
