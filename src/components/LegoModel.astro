---
const photos = [
  { src: "/images/lego/lego-physical.jpg", caption: "The physical Lego model — front elevation showing Wright's Prairie proportions and horizontal massing" },
  { src: "/images/lego/lego-render-01.png", caption: "Stud.io digital render — front and side elevation, showing the stair tower, cantilevered eaves, and entry" },
  { src: "/images/lego/lego-render-02.png", caption: "Stud.io digital render — rear and side elevation, showing the roof garden and low-slung main block" },
];
---

<section class="lego" id="lego">
  <div class="container">
    <div class="lego-header">
      <p class="section-label">In Miniature</p>
      <h2 class="section-title">A Lego Tribute</h2>
      <div class="divider"></div>
      <p class="lego-intro">
        A custom Lego model of the Booth House — capturing Wright's signature horizontal
        lines, cantilevered eaves, stair tower, and Prairie proportions brick by brick.
        The model was designed in <a href="https://www.bricklink.com/v3/studio/download.page" target="_blank" rel="noopener" class="lego-link">Stud.io</a>,
        BrickLink's free Lego design application. Download the model file below to open,
        explore, or modify it yourself.
      </p>
      <a href="/downloads/ShermanBoothHouse.io" download class="lego-download">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Download Stud.io Model File — Sherman Booth House.io
      </a>
    </div>

    <div class="lego-layout">
      <!-- Hero lego shot -->
      <a href={photos[0].src} class="glightbox lego-hero-img" data-gallery="lego" data-description={photos[0].caption}>
        <img src={photos[0].src} alt={photos[0].caption} />
        <div class="lego-hero-caption">{photos[0].caption}</div>
      </a>

      <!-- Secondary grid -->
      <div class="lego-grid">
        {photos.slice(1).map(photo => (
          <a href={photo.src} class="glightbox lego-thumb" data-gallery="lego" data-description={photo.caption}>
            <img src={photo.src} alt={photo.caption} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .lego {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .lego-header {
    max-width: var(--content-width);
    margin: 0 auto var(--space-lg);
  }

  .lego-intro {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 300;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-top: calc(-1 * var(--space-sm));
  }

  .lego-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .lego-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-md);
    padding: 0.65rem 1.25rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.2s, color 0.2s;
  }

  .lego-download:hover {
    background: var(--color-accent);
    color: var(--color-white);
  }

  .lego-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: start;
  }

  .lego-hero-img {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4/3;
    background: var(--color-border);
  }

  .lego-hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .lego-hero-img:hover img {
    transform: scale(1.03);
  }

  .lego-hero-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem 1rem 0.75rem;
    background: linear-gradient(transparent, rgba(0,0,0,0.5));
    color: white;
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lego-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-content: start;
  }

  .lego-thumb {
    display: block;
    overflow: hidden;
    aspect-ratio: 4/3;
    background: var(--color-border);
  }

  .lego-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .lego-thumb:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 768px) {
    .lego-layout {
      grid-template-columns: 1fr;
    }

    .lego-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
