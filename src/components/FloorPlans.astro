---
const plans = [
  { src: "/images/floor-plans/avery/02-ground-plan.jpg", label: "Ground Floor Plan", description: "Kitchen, dining room, living room, bedrooms 1–3, sitting porch · Drawing 2" },
  { src: "/images/floor-plans/avery/03-second-story-roof-plan.jpg", label: "Second Story & Roof Plan", description: "Bedrooms 4–6, sleeping porch, roof garden · Drawing 3" },
  { src: "/images/floor-plans/avery/01-basement-plan.jpg", label: "Basement & Foundation Plan", description: "Lower level showing original stable footprint and new foundations · Drawing 1" },
  { src: "/images/floor-plans/avery/04-east-west-elevations.jpg", label: "East & West Elevations", description: "Full exterior elevations — stucco tower, deep eaves, horizontal massing · Drawing 4" },
  { src: "/images/floor-plans/avery/05-north-south-elevations-sections.jpg", label: "North & South Elevations & Sections", description: "Cross-sections through the living room tower reveal the four-story height · Drawing 5" },
  { src: "/images/floor-plans/avery/06-longitudinal-sections.jpg", label: "Longitudinal Sections", description: "Full-length sections looking east and west through the main block · Drawing 6" },
  { src: "/images/floor-plans/avery/09-light-fixtures.jpg", label: "Light Fixture Details", description: "Wright's original light fixture designs, dated June 3, 1913 · Drawing 1502.16" },
  { src: "/images/floor-plans/avery/07-ceiling-light-detail.jpg", label: "Ceiling Light — Main Stair Landing", description: "Detail drawing for the ceiling light with ventilation grille, dated September 27, 1916 · Drawing 1502.12" },
  { src: "/images/floor-plans/avery/08-bed-design.jpg", label: "Wright-Designed Bed", description: "Original bed design — black walnut, natural wax finish. Five ordered for the house · Drawing 1502.14" },
  { src: "/images/floor-plans/avery/10-stair-section.jpg", label: "Stair Section & Spindle Details", description: "Section through stairway with full-size spindle pattern and ornamental screen · Drawing 1502.30" },
];
---

<section class="floor-plans" id="floor-plans">
  <div class="container">
    <div class="fp-header">
      <p class="section-label">Architectural Drawings</p>
      <h2 class="section-title">Original Floor Plans</h2>
      <div class="divider"></div>
      <p class="fp-intro">
        Original Frank Lloyd Wright drawings for the Booth House, Scheme 2 — from the Frank Lloyd Wright
        Foundation Archives held at the Avery Architectural & Fine Arts Library, Columbia University.
        Click any drawing to view full-size.
      </p>
    </div>

    <div class="fp-grid">
      {plans.map(plan => (
        <a href={plan.src} class="glightbox fp-item" data-gallery="plans" data-description={`${plan.label} — ${plan.description}`}>
          <div class="fp-thumb">
            <img src={plan.src} alt={plan.label} loading="lazy" />
            <div class="fp-zoom-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.35-4.35M11 8v6M8 11h6"/>
              </svg>
            </div>
          </div>
          <div class="fp-info">
            <span class="fp-label">{plan.label}</span>
            <span class="fp-desc">{plan.description}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .floor-plans {
    background: var(--color-bg);
  }

  .fp-header {
    max-width: var(--content-width);
    margin: 0 auto var(--space-lg);
  }

  .fp-intro {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 300;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-top: calc(-1 * var(--space-sm));
  }

  .fp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(460px, 1fr));
    gap: var(--space-md);
  }

  .fp-item {
    display: block;
    border: 1px solid var(--color-border);
    transition: box-shadow 0.3s;
  }

  .fp-item:hover {
    box-shadow: 0 8px 30px rgba(0,0,0,0.1);
  }

  .fp-thumb {
    position: relative;
    aspect-ratio: 4/3;
    background: #f5f0e8;
    overflow: hidden;
  }

  .fp-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
    filter: sepia(5%) contrast(1.1);
    transition: transform 0.3s ease;
  }

  .fp-item:hover .fp-thumb img {
    transform: scale(1.02);
  }

  .fp-zoom-icon {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .fp-item:hover .fp-zoom-icon {
    opacity: 1;
  }

  .fp-info {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-white);
  }

  .fp-label {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    color: var(--color-text);
  }

  .fp-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    font-style: italic;
  }

  @media (max-width: 600px) {
    .fp-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
